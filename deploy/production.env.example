DATABASE_URL="file:/var/lib/orbit/orbit.db"
APP_ORIGIN="https://orbit.server-uniofweb.ru"
AUTH_EMAIL="seo@uniofweb.ru"
WORKER_HEADLESS="1"
WORKER_PLAN_MODE="local"
WORKER_PROXY_CHECK_URL="https://www.wikipedia.org/"
WORKER_PROFILES_DIR="/var/lib/orbit/profiles"
PLAYWRIGHT_BROWSERS_PATH="/var/lib/orbit/browsers"
NEXT_TELEMETRY_DISABLED="1"
WORKER_PROXY_IP_CHECK_MODE="warn"
WORKER_PROXY_IP_CHECK_URL="https://orbit.server-uniofweb.ru/_orbit/ip/"
WORKER_PROXY_IP_CHECK_TIMEOUT_MS="5000"
# Optional direct worker egress comparison when the host cannot reach its edge.
WORKER_DIRECT_IP_CHECK_URL="https://api.ipify.org?format=json"

# Dynamic synthetic quiet-held sensors; does not change the device fingerprint.
WORKER_MOTION_MODE=quiet-held
# Use off to preserve the browser default sensor behavior.

# Optional browser-only network diagnostics. Empty URL disables external probes.
ORBIT_NETWORK_PROBE_URL=
ORBIT_NETWORK_HTTP3_URL=
ORBIT_NETWORK_REFERENCE_FILE=
ORBIT_NETWORK_PROBE_TIMEOUT_MS=12000

# Install curated fonts with scripts/prepare-browser-fonts.mjs before enabling.
# FONTCONFIG_FILE=/var/lib/orbit/android-fonts-v1/fonts.conf
ORBIT_COOKIE_MIN_AGE_HOURS=72
